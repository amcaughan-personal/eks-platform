# Logs that must outlive any one cluster: Airflow's task logs in S3, and each cluster's
# control-plane and container logs in CloudWatch. EKS writes control-plane logs to
# /aws/eks/<cluster>/cluster; creating that group here sets its retention, and nothing
# is left behind when a cluster is deleted.

data "aws_caller_identity" "current" {}

module "task_logs" {
  #checkov:skip=CKV_AWS_144:Logs that can be regenerated by rerunning a task; no second region needed
  #checkov:skip=CKV_AWS_145:SSE-S3 encryption; a customer KMS key adds cost and nothing for these logs
  #checkov:skip=CKV2_AWS_62:Nothing reacts to new log files
  #checkov:skip=CKV_AWS_18:Access logs for a log bucket would only log the logging
  source  = "terraform-aws-modules/s3-bucket/aws"
  version = "5.18.0"

  bucket = "${var.name}-task-logs-${data.aws_caller_identity.current.account_id}"

  # Task logs can be regenerated by rerunning the task, so a destroy empties the bucket
  # instead of stopping on it.
  force_destroy = true

  attach_deny_insecure_transport_policy = true

  server_side_encryption_configuration = {
    rule = {
      apply_server_side_encryption_by_default = { sse_algorithm = "AES256" }
    }
  }

  versioning = { enabled = true }

  lifecycle_rule = [
    {
      id                                     = "expire"
      enabled                                = true
      filter                                 = {}
      expiration                             = { days = var.retention_days }
      noncurrent_version_expiration          = { days = 1 }
      abort_incomplete_multipart_upload_days = 1
    },
  ]
}

resource "aws_cloudwatch_log_group" "control_plane" {
  for_each = toset(var.clusters)

  name              = "/aws/eks/${each.key}/cluster"
  retention_in_days = var.retention_days
}

resource "aws_cloudwatch_log_group" "containers" {
  for_each = toset(var.clusters)

  name              = "/${var.name}/${each.key}/containers"
  retention_in_days = var.retention_days
}
